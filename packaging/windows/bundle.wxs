<?xml version="1.0" encoding="utf-8"?>
<!-- Draft only: validate upgrade and uninstall behaviour with an isolated Windows install. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle Name="EmuSync" Manufacturer="EmuSync" Version="$(var.Version)"
          UpgradeCode="ae7dae9f-fe3d-4943-9305-b5a8723254aa" IconSourceFile="$(var.IconFile)">
    <BootstrapperApplication>
      <bal:WixInternalUIBootstrapperApplication />
    </BootstrapperApplication>
    <Chain>
      <MsiPackage SourceFile="$(var.MsiFile)" />
    </Chain>
  </Bundle>
</Wix>
