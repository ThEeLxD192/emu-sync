<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- The UpgradeCode is the one of the Kotlin MSI, so this package upgrades those installs. -->
  <Package Name="EmuSync" Manufacturer="EmuSync" Version="$(var.Version)"
           UpgradeCode="a7b3c291-5f4e-4b28-98e1-d63f5e824c90" Scope="perMachine">
    <MajorUpgrade Schedule="afterInstallInitialize" AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of EmuSync is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="EmuSync.ico" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="EmuSync.ico" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="EmuSync">
        <Component Id="ApplicationFiles">
          <File Id="EmuSyncExecutable" Source="$(var.Executable)" Name="EmuSync.exe" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="EmuSyncMenuFolder" Name="EmuSync">
        <Component Id="StartMenuShortcut">
          <Shortcut Id="EmuSyncStartMenu" Name="EmuSync" Target="[INSTALLFOLDER]EmuSync.exe"
                    WorkingDirectory="INSTALLFOLDER" Icon="EmuSync.ico" />
          <RemoveFolder Id="RemoveEmuSyncMenuFolder" On="uninstall" />
          <RegistryValue Root="HKLM" Key="Software\EmuSync\Installer" Name="StartMenu"
                         Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="MainFeature" Title="EmuSync" Level="1">
      <ComponentRef Id="ApplicationFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- The in-app updater passes AUTOLAUNCH=1 and exits, so the new version opens by itself
         once it is installed. Other installs, and uninstalls, never launch the application. -->
    <Property Id="AUTOLAUNCH" Secure="yes" />
    <CustomAction Id="LaunchEmuSync" FileRef="EmuSyncExecutable" ExeCommand=""
                  Return="asyncNoWait" />
    <InstallExecuteSequence>
      <Custom Action="LaunchEmuSync" After="InstallFinalize"
              Condition="AUTOLAUNCH = &quot;1&quot; AND NOT REMOVE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
