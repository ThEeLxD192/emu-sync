#!/usr/bin/env bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

rust=false
while IFS= read -r -d '' path; do
    case "$path" in
        .gitattributes|.editorconfig|.githooks/*|.github/workflows/ci.yml|scripts/install-git-hooks.sh|*.rs|Cargo.toml|Cargo.lock|*/Cargo.toml|rust-toolchain.toml|.cargo/*|rust/*|xtask/*)
            rust=true
            ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACDMRT -z)

if [[ "$rust" != true ]]; then
    exit 0
fi

# Export only the index. Never stash, reset, stage, or rewrite the user's files.
snapshot=$(mktemp -d "${TMPDIR:-/tmp}/emusync-quality.XXXXXXXX")
trap 'rm -rf -- "$snapshot"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP
git checkout-index --all --prefix="$snapshot/"

if [[ ! -f "$snapshot/Cargo.lock" ]]; then
    echo "Quality check failed: the staged commit must include Cargo.lock." >&2
    exit 1
fi
echo "Checking Rust quality against the staged commit..."
(cd "$snapshot" && cargo xtask quality)
